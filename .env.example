VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=alumni

# ClickNPay gateway (publicUniqueId is public config, not a secret)
VITE_CLICKNPAY_PUBLIC_UNIQUE_ID=
VITE_CLICKNPAY_RETURN_URL=

# Server-side (Vercel serverless function proxy)
CLICKNPAY_PUBLIC_UNIQUE_ID=
CLICKNPAY_RETURN_URL=

# Full-screen background video, hosted externally.
# Vercel enforces a hard 100MB per-file limit, so large videos must live on a
# CDN (Cloudinary, Bunny Stream, Cloudflare R2, Supabase Storage, etc.).
# Leave empty to use the built-in animated gradient background.
VITE_BACKGROUND_VIDEO_URL=

# Optional email delivery. Either EmailJS (client-side) or a webhook (server-side).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAIL_WEBHOOK_URL=
